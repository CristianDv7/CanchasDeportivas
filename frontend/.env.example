# Copiar a frontend/.env (gitignored) antes de levantar cualquier app.
# Es un unico archivo compartido por las 4 apps (shell + 3 remotes):
# cada rsbuild.config.ts lo lee desde la raiz de frontend/ (ver loadEnv({ cwd }))
# aunque el comando se corra desde el directorio de una app individual.
#
# Puertos de los ms-*: NINGUNO esta fijado en backend/ (no hay uvicorn.run,
# ni Dockerfile, ni .env versionado en ningun ms-*, verificado leyendo los 4
# app/main.py y app/core/config.py). Se adoptan los valores provisorios que
# ya proponia design.md seccion 7 - documentado en tasks.md 1.1 / apply-progress.
# Si tu companero de backend levanta los microservicios en otros puertos,
# ajusta estas 4 lineas, nada mas.

# ---- Variables publicas (llegan al bundle del browser via import.meta.env) ----

# Base de la API same-origin servida por el proxy del dev server del shell.
PUBLIC_API_BASE=/api

# Origenes de los 3 remotes, usados por el shell para construir las URLs de
# remoteEntry/mf-manifest.
PUBLIC_MF_RESERVAS_URL=http://localhost:3001
PUBLIC_MF_ADMINISTRACION_URL=http://localhost:3002
PUBLIC_MF_REPORTES_URL=http://localhost:3003

# Origen del shell, usado por los 3 remotes para federar de vuelta
# 'shell/session' y 'shell/apiClient'.
PUBLIC_SHELL_URL=http://localhost:3000

# Mostrado en RemoteHealthCard para detectar bundles viejos/cache.
# Reemplazar por un timestamp/hash real cuando exista un pipeline de build.
PUBLIC_BUILD_ID=dev-local

# ---- Variables server-side (solo las lee el proxy del dev server del shell;
# el bundle del browser NUNCA debe verlas: por eso NO llevan prefijo PUBLIC_) ----

MS_USUARIOS_URL=http://localhost:8001
MS_CANCHAS_URL=http://localhost:8002
MS_RESERVAS_URL=http://localhost:8003
MS_REPORTES_URL=http://localhost:8004
